# ── Angel One SmartAPI (REQUIRED) ────────────────────────────────────────────
# Primary live tick feed for NIFTY + CRUDEOIL. Get these from your Angel One
# account dashboard (Settings → API). ANGEL_TOTP_SECRET is required for
# automated login each session — enable TOTP on your account first.
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_client_id_here
ANGEL_PASSWORD=your_login_pin_here
ANGEL_TOTP_SECRET=your_totp_secret_here

# ── Fyers (recommended) ───────────────────────────────────────────────────────
# Primary PCR / option-chain data source (NIFTY, CRUDEOIL, and — for the
# Combined PCR feature — BankNifty/Sensex/individual stocks). Without this,
# the app falls back to scraping NSE directly.
FYERS_APP_ID=your_fyers_app_id
FYERS_SECRET_ID=your_fyers_secret_id
FYERS_ACCESS_TOKEN=your_fyers_access_token
FYERS_REFRESH_TOKEN=your_fyers_refresh_token
FYERS_PIN=your_fyers_pin

# ── PostgreSQL (recommended) ──────────────────────────────────────────────────
# Powers Journal, Analytics, and every signal/performance history table.
# On Railway, attach a Postgres database to the project and this gets wired
# in automatically — don't set it manually there.
DATABASE_URL=postgresql://user:password@host:port/dbname

# ── Telegram (recommended) ────────────────────────────────────────────────────
# All alert types (main signals, MTF tracker, exploratory triggers, Murarka
# entries, weekly self-review, etc.) go through this bot.
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# ── Anthropic (optional) ──────────────────────────────────────────────────────
# Used for News Sentiment scoring (one prompt scores recent headlines as
# bullish/bearish/neutral). No new LLM provider needed beyond this key.
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── App security (optional but recommended if the URL is ever shared) ────────
# When set, locks down API endpoints — requests need an X-App-Token header
# or ?key= query param matching this value.
APP_TOKEN=choose_your_own_secret_string

# ── Optional fallback / secondary data sources ────────────────────────────────
NEWSAPI_KEY=
FINNHUB_API_KEY=
SCRAPERAPI_KEY=

# ── Signal engine tuning flags (optional — sensible defaults if unset) ───────
ALL_FACTORS_HARD_GATE=
DYNAMIC_LEVELS_HARD_GATE=
MIN_STRIKE_OI=
MIN_STRIKE_VOLUME=
SCALP_ALERTS_ENABLED=

# ── Port (optional — Railway sets this automatically) ────────────────────────
PORT=3000
